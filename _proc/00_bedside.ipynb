       ">                          y_date_column='date', y_seconds_since_column='Time\n",
       ">                          Stamp (seconds)', y_outcome='hypotension',\n",
       ">                          max_seq_len_sec=None, sample_df=None,\n",
       ">                          sample_seq_len_sec=None, sample_stride_sec=None,\n",
       ">                          frequency=125, butterworth_filters=None,\n",
       ">                          median_filter_kernel_size=None,\n",
       ">                          clip_interpolations=None, nan_tolerance=0.2)\n",
